# apps/mobile — every variable the Expo app reads.
# Only EXPO_PUBLIC_* variables are inlined into the JS bundle; anything secret
# must never be prefixed with EXPO_PUBLIC_ (PLAN §2.6).
# Copy to apps/mobile/.env.local for local dev; for EAS builds set the same
# names as EAS environment variables (`eas env:create`) — never commit values.

# --- Supabase: aomsc-function-room (rwpglslbkhsqyxjhnpue) ---
EXPO_PUBLIC_SUPABASE_URL=https://rwpglslbkhsqyxjhnpue.supabase.co
# Anon key only. RLS is the security boundary; the service-role key must never
# reach a device.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Build-time only (not bundled) ---
# Written by `eas init`; also read from the environment so CI need not commit it.
EAS_PROJECT_ID=
# development | preview | production — drives app name and bundle id suffix.
APP_VARIANT=development
