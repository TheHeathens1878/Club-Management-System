# Root reference for every variable used across the monorepo (PLAN §2.6).
# Per-app copies live in apps/web/.env.example and apps/mobile/.env.example.
# Never commit real values.

# --- Supabase project: aomsc-function-room (rwpglslbkhsqyxjhnpue) ---
SUPABASE_PROJECT_ID=rwpglslbkhsqyxjhnpue
# Service-role key: server-side only (Edge Functions, scripts, apps/web server
# actions). Bypasses RLS — never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for `supabase link` in CI (P0.2/P0.3).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Web (apps/web) — function-room app imported in P0.4 ---
NEXT_PUBLIC_SUPABASE_URL=https://rwpglslbkhsqyxjhnpue.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL; used for absolute links in email and payment return URLs.
NEXT_PUBLIC_SITE_URL=https://roombooking.aomsportsclub.co.uk

# Bearer token Vercel Cron sends to /api/cron/payment-reminders (apps/web/vercel.json).
CRON_SECRET=

# Microsoft Graph (Azure Entra ID app registration): outbound booking email and
# Outlook calendar sync. Blank = email/calendar silently skipped.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Sending mailbox, e.g. bookings@aomsportsclub.co.uk.
MAIL_FROM=
# Mailbox whose calendar holds booking events. Defaults to MAIL_FROM.
CALENDAR_USER=

# Web push (VAPID). Blank public key = push UI hidden, sends are no-ops.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# SumUp Online Payments (booker portal). Blank merchant code = mock pay stand-in.
SUMUP_MERCHANT_CODE=
SUMUP_API_KEY=
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_API_BASE=

# Stripe (legacy — superseded by SumUp for the booker flow).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_SUPABASE_URL=https://rwpglslbkhsqyxjhnpue.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
