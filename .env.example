# Root reference for every variable used across the monorepo (PLAN §2.6).
# Per-app copies live in apps/web/.env.example and apps/mobile/.env.example.
# Never commit real values.

# --- Supabase project: aomsc-function-room (rwpglslbkhsqyxjhnpue) ---
SUPABASE_PROJECT_ID=rwpglslbkhsqyxjhnpue
# Service-role key: server-side only (Edge Functions, scripts, apps/web server
# actions). Bypasses RLS — never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for `supabase link` in CI (P0.2/P0.3).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Web (apps/web) — function-room app imported in P0.4 ---
NEXT_PUBLIC_SUPABASE_URL=https://rwpglslbkhsqyxjhnpue.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL; used for absolute links in email and payment return URLs.
NEXT_PUBLIC_SITE_URL=https://roombooking.aomsportsclub.co.uk

# Bearer token Vercel Cron sends to /api/cron/payment-reminders (apps/web/vercel.json).
CRON_SECRET=

# Microsoft Graph (Azure Entra ID app registration): outbound booking email and
# Outlook calendar sync. Blank = email/calendar silently skipped.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Sending mailbox, e.g. bookings@aomsportsclub.co.uk.
MAIL_FROM=
# Mailbox whose calendar holds booking events. Defaults to MAIL_FROM.
CALENDAR_USER=

# Signing secret for Supabase Auth's "Send Email" hook, which posts every
# confirmation / magic-link / recovery / email-change / invite email to
# /api/auth/send-email so Microsoft Graph sends it instead of Supabase's
# rate-limited mailer. Generated when the hook is enabled in the dashboard;
# format `v1,whsec_<base64>`.
SUPABASE_AUTH_EMAIL_HOOK_SECRET=

# Web push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
#
# THREE PLACES, and they are not interchangeable:
#   · NEXT_PUBLIC_VAPID_PUBLIC_KEY — Vercel. Inlined at BUILD time, so setting
#     it needs a redeploy before it takes effect. Blank means the browser is
#     never asked for a push permission (the Add-to-Home-Screen prompt still
#     appears; the two were separated on 2026-09-02 precisely so a missing key
#     could not hide both).
#   · VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_EMAIL — Supabase Edge
#     Function secrets (`supabase secrets set`), read by comms-dispatch. The
#     private key never reaches a browser. VAPID_EMAIL is a mailto: the push
#     service can complain to; the club's own address is right.
#   · both public values MUST be the same key, or every subscription made by
#     the browser is one the sender cannot sign for.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# SumUp Online Payments (booker portal). Blank merchant code = mock pay stand-in.
SUMUP_MERCHANT_CODE=
SUMUP_API_KEY=
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_API_BASE=

# Stripe (legacy — superseded by SumUp for the booker flow).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_SUPABASE_URL=https://rwpglslbkhsqyxjhnpue.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
