# apps/web — every variable the web app reads (grep `process.env.` in src/).
# Values live in Vercel env config, never in the repo (PLAN §2.6).
# Copy to apps/web/.env.local for local dev.

# --- Supabase: aomsc-function-room (rwpglslbkhsqyxjhnpue) ---
NEXT_PUBLIC_SUPABASE_URL=https://rwpglslbkhsqyxjhnpue.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER-ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL ---
# Used to build absolute links in emails and payment return URLs.
# getSiteUrl() throws at request time if this is missing (not needed to build).
NEXT_PUBLIC_SITE_URL=https://roombooking.aomsportsclub.co.uk

# --- Vercel Cron ---
# Bearer token Vercel sends to /api/cron/payment-reminders (see vercel.json).
# The route returns 500 if unset. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# --- Microsoft Graph (Azure Entra ID app registration) ---
# Outbound email and Outlook calendar sync. If any of these is blank the app
# logs "Microsoft Graph … not configured" and skips sending/syncing.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Mailbox that sends booking email, e.g. bookings@aomsportsclub.co.uk.
MAIL_FROM=
# Mailbox whose calendar receives booking events. Defaults to MAIL_FROM.
CALENDAR_USER=

# --- Web push (VAPID) ---
# If NEXT_PUBLIC_VAPID_PUBLIC_KEY is blank the notification prompt is hidden and
# push sending is a no-op. Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address for the push service; defaults to mailto:admin@example.com.
VAPID_EMAIL=

# --- SumUp Online Payments (booker portal) ---
# Leave SUMUP_MERCHANT_CODE blank to use the mock "pay" stand-in.
SUMUP_MERCHANT_CODE=
# Option A (preferred): a secret API key from SumUp developer settings.
SUMUP_API_KEY=
# Option B: OAuth client credentials, used only if SUMUP_API_KEY is blank.
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
# Optional override; defaults to https://api.sumup.com.
SUMUP_API_BASE=

# --- Stripe (legacy) ---
# Superseded by SumUp for the booker flow. src/lib/stripe.ts still reads these
# and returns a null client when STRIPE_SECRET_KEY is blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
